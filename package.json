{
  "name": "@platypus/node",
  "version": "0.1.0",
  "description": "Node.js SDK for the Platypus logging service",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "keywords": [
    "logging",
    "logger",
    "observability",
    "backend",
    "platypus"
  ],
  "author": "Felix Kamau",
  "license": "MIT",
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.7.3"
  }
}
