{
  "name": "@platypus/node",
  "version": "0.1.0",
  "description": "Node.js SDK for the Platypus logging service",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "keywords": [
    "logging",
    "logger",
    "observability",
    "backend",
    "node",
    "nodejs",
    "typescript",
    "platypus"
  ],
  "author": "Felix Kamau",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felixkamau/platypus-node.git"
  },
  "bugs": {
    "url": "https://github.com/felixkamau/platypus-node/issues"
  },
  "homepage": "https://github.com/felixkamau/platypus-node#readme",
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@types/node": "^26.6.2"
  }
}
